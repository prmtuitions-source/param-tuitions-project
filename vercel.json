{
  "outputDirectory": "dist",
  "buildCommand": "",
  "installCommand": "",
  "routes": [
    { "src": "/about",               "headers": { "Location": "https://paramtuitionbureau.com/about"         }, "status": 301 },
    { "src": "/contact",             "headers": { "Location": "https://paramtuitionbureau.com/contact"       }, "status": 301 },
    { "src": "/faq",                 "headers": { "Location": "https://paramtuitionbureau.com/about"         }, "status": 301 },
    { "src": "/terms",               "headers": { "Location": "https://paramtuitionbureau.com/terms"         }, "status": 301 },
    { "src": "/policy",              "headers": { "Location": "https://paramtuitionbureau.com/privacy"       }, "status": 301 },
    { "src": "/privacy",             "headers": { "Location": "https://paramtuitionbureau.com/privacy"       }, "status": 301 },
    { "src": "/blog(.*)",            "headers": { "Location": "https://paramtuitionbureau.com/"              }, "status": 301 },
    { "src": "/available-tuitions",  "headers": { "Location": "https://paramtuitionbureau.com/tuitions"      }, "status": 301 },
    { "src": "/apply-tuition",       "headers": { "Location": "https://paramtuitionbureau.com/apply-tuition" }, "status": 301 },
    { "src": "/find-tutors",         "headers": { "Location": "https://paramtuitionbureau.com/find-tutor"    }, "status": 301 },
    { "src": "/post-inquiry",        "headers": { "Location": "https://paramtuitionbureau.com/find-tutor"    }, "status": 301 },
    { "src": "/tutors-in/(.*)",      "headers": { "Location": "https://paramtuitionbureau.com/find-tutor"    }, "status": 301 },
    { "src": "/login-teacher",       "headers": { "Location": "https://paramtuitionbureau.com/login-teacher" }, "status": 301 },
    { "src": "/teacher-register",    "headers": { "Location": "https://paramtuitionbureau.com/teacher-register" }, "status": 301 },
    { "src": "/upload-identity",     "headers": { "Location": "https://paramtuitionbureau.com/teacher/upload-identity" }, "status": 301 },
    { "src": "/",                    "headers": { "Location": "https://paramtuitionbureau.com/"              }, "status": 301 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html", "status": 200 }
  ]
}
